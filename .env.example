# Copernicus Data Space Ecosystem (for Sentinel-2 downloads)
# For product DOWNLOAD you need USER + PASS (password grant with client_id=cdse-public).
# CLIENT_ID + CLIENT_SECRET may work for catalog search but often give 401 on download.
COPERNICUS_USER=
COPERNICUS_PASS=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# CDSE S3 credentials (FASTER downloads — bypasses HTTP download queue)
# Generate at: dataspace.copernicus.eu -> Login -> User Settings -> S3 Access -> Generate
# When set, the script uses S3 automatically (3-10x faster than HTTP zipper).
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
